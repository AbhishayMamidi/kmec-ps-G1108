# NeuroSentinel Frontend — Environment Variables Template
# Copy this to .env.local and fill in your values. NEVER commit .env.local to git.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=eeg-uploads

# --- AI ---
GOOGLE_GEMINI_API_KEY=your-google-gemini-api-key

# --- Email ---
# IMPORTANT: Use a DEDICATED Gmail account (not your personal one).
# Create a new Gmail e.g. neurosentinelai.noreply@gmail.com
# Then enable 2FA and generate an App Password at: https://myaccount.google.com/apppasswords
#
# Gmail SMTP automatically provides SPF + DKIM authentication for @gmail.com senders — free.
# No custom domain or paid service required.
#
SMTP_USER=neurosentinelai.noreply@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM_EMAIL=neurosentinelai.noreply@gmail.com
SMTP_FROM_NAME=NeuroSentinel AI
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587


# --- Backend ---
NEUROSENTINEL_BACKEND_URL=https://your-backend.onrender.com

# --- Auth ---
OTP_SIGNING_SECRET=your-random-32-char-secret
